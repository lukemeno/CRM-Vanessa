# Postgres in the EU (Fly Postgres or Railway, Frankfurt). Do not use a US region.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/crm_vanessa

# Auth.js — generate with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# Comma-separated operator emails. Vanessa and Luke only.
AUTH_ALLOWLIST=vanessa@events-altehettnerfabrik.de,luke@example.com

# SMTP for magic-link mail. Required in production.
EMAIL_SERVER=smtp://user:password@127.0.0.1:1025
EMAIL_FROM="Events by Vanessa <vanessa@events-altehettnerfabrik.de>"

# Local-dev bypass: print the magic-link URL to the server console instead of sending mail.
# The app IGNORES this unless NODE_ENV=development. Never set this in production.
# AUTH_DEV_BYPASS=1
